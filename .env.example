# Website email
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ada@example.com
SMTP_PASS=replace_with_smtp_password
SMTP_FROM_EMAIL=ada@example.com
SMTP_FROM_NAME=HCJ Piston Rod Website
RFQ_TO_EMAIL=ada@example.com

# Admin database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hcj_admin
DATABASE_SSL=false
ADMIN_SESSION_SECRET=replace_with_at_least_32_random_chars
ADMIN_SETUP_EMAIL=ada@hcjpistonrod.com

# Initial admin creation
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_password
ADMIN_NAME=超级管理员

# Object storage, configure before enabling upload APIs
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# External data sources, optional
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
GOOGLE_SEARCH_CONSOLE_ENABLED=false
GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:hcjpistonrod.com
GOOGLE_SEARCH_CONSOLE_SITEMAP_URL=https://www.hcjpistonrod.com/sitemap.xml
GOOGLE_SITEMAP_SUBMIT_INTERVAL_HOURS=72
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS_PATH=
GOOGLE_SERVICE_ACCOUNT_JSON=
ANALYTICS_PROVIDER=
ANALYTICS_API_KEY=
WEBHOOK_SECRET=

CRON_SECRET=replace_with_random_cron_secret

# Controlled content operations. Keep these defaults until reviewers, approved
# sources and a least-privilege GitHub token have been configured in Vercel.
CONTENT_OPS_ENABLED=false
CONTENT_OPS_DRY_RUN=true
PUBLISH_MODE=draft_only
AUTO_PUBLISH=false
CONTENT_OPS_CHANNEL=news
CONTENT_OPS_TIMEZONE=Asia/Shanghai
NEWS_MAX_AGE_DAYS=90
MAX_ARTICLES_PER_RUN=1
TITLE_SIMILARITY_THRESHOLD=0.82
CONTENT_SIMILARITY_THRESHOLD=0.72
OPENAI_API_KEY=
CONTENT_GENERATION_MODEL=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_CONTENT_TOKEN=
